generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Platform {
  id                 String      @id @default(uuid())
  adDriverVersion    Int?
  adCustomerVersion  Int?
  iosCustomerVersion String?
  appDescription     AppPlatform @unique
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
}

model User {
  id                     String                 @id @default(uuid())
  role                   UserRole
  email                  String?                @unique
  status                 UserStatus             @default(ACTIVE)
  country                Country?
  metadata               Json?
  lastLogin              DateTime?
  createdAt              DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(6)
  admin                  Admin?
  announcementDeliveries AnnouncementDelivery[]
  customer               Customer?
  deviceTokens           DeviceToken?
  pilot                  Pilot?
  promoter               Promoter?
  superAdmin             SuperAdmin?
  support                Support?
  supportTickets         SupportTicket[]
}

model DeviceToken {
  userId          String   @id @unique
  fcmToken        String
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  dateTime        String?
  platform        String?
  platformVersion String?
  user            User     @relation(fields: [userId], references: [id])

  @@index([fcmToken])
}

model SuperAdmin {
  id       String @id @default(uuid())
  name     String
  userId   String @unique
  password String
  user     User   @relation(fields: [userId], references: [id])
}

model Admin {
  id        String   @id @default(uuid())
  name      String
  userId    String   @unique
  password  String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id])
}

model SupportRole {
  id                 String              @id @default(uuid())
  name               String              @unique
  description        String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  support            Support[]
  supportPermissions SupportPermission[] @relation("SupportPermissionToSupportRole")
}

model Support {
  id                 String               @id @default(uuid())
  userId             String               @unique
  name               String
  password           String
  phone              String?
  referralCode       String?              @unique
  supportRoleId      String
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(6)
  CancellationReason CancellationReason[]
  supportRole        SupportRole          @relation(fields: [supportRoleId], references: [id])
  user               User                 @relation(fields: [userId], references: [id])
  supportTickets     SupportTicket[]
}

model SupportPermission {
  id          String        @id @default(uuid())
  menuKey     String        @unique
  isVisible   Boolean       @default(true)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)
  supportRole SupportRole[] @relation("SupportPermissionToSupportRole")
}

model Promoter {
  id                    String   @id @default(uuid())
  userId                String   @unique
  phone                 String   @unique
  name                  String?
  address               String?
  bloodGroup            String?
  livePhotoUrl          String?
  idPhotoUrl            String?
  nidPhotoUrl           String?
  referralCode          String   @unique
  isAlreadyRegistered   Boolean  @default(false)
  isApproved            Boolean  @default(false)
  totalDriversOnboarded Int      @default(0)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)
  onboardedPilots       Pilot[]
  user                  User     @relation(fields: [userId], references: [id])
}

model Customer {
  id                    String           @id @default(uuid())
  phone                 String           @unique
  email                 String?          @unique
  userId                String           @unique
  isAlreadyRegistered   Boolean          @default(false)
  isOnboardingCompleted Boolean          @default(false)
  isEmailVerified       Boolean          @default(false)
  name                  String?
  avatar                String?
  averageRating         Float            @default(5.0)
  createdAt             DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(6)
  languageId            String
  couponId              String?
  activeBookingId       String?          @unique
  bookings              Booking[]
  activeBooking         Booking?         @relation("CustomerActiveBooking", fields: [activeBookingId], references: [id])
  coupon                Coupon?          @relation(fields: [couponId], references: [id])
  language              Languages        @relation(fields: [languageId], references: [id])
  user                  User             @relation(fields: [userId], references: [id])
  ratings               CustomerRating[]
  savedPlaces           SavedPlace[]
}

model Coupon {
  id         String     @id @default(uuid())
  name       String     @unique
  discount   Decimal    @default(0.00) @db.Decimal(10, 2)
  validUntil DateTime?  @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  customers  Customer[]
}

model SavedPlace {
  id         String         @id @default(uuid())
  customerId String
  name       String?
  address    String
  type       SavedPlaceType @default(OTHERS)
  location   Json?
  customer   Customer       @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model Pilot {
  id                              String                   @id @default(uuid())
  phone                           String                   @unique
  userId                          String                   @unique
  selfieUrl                       String?
  dlFrontSideUrl                  String?
  dlBackSideUrl                   String?
  nidFrontSideUrl                 String?
  nidBackSideUrl                  String?
  vehicleOwnersNidFrontSideUrl    String?
  vehicleOwnersNidBackSideUrl     String?
  rcFrontSideUrl                  String?
  rcBackSideUrl                   String?
  numberPlateUrl                  String?
  taxTokenUrl                     String?
  languageId                      String
  referralCode                    String?
  onlineStatus                    PilotStatus              @default(OFFLINE)
  activeBookingId                 String?                  @unique
  isAlreadyRegistered             Boolean                  @default(false)
  averageRating                   Float                    @default(5.0)
  totalTrips                      Int                      @default(0)
  pilotProgramId                  String?
  acceptedTerms                   Boolean                  @default(true)
  isSelfieVerified                VerificationStatus       @default(PENDING)
  selfieRejectionReason           String?
  isNidVerified                   VerificationStatus       @default(PENDING)
  nidRejectionReason              String?
  isVehicleOwnersNidVerified      VerificationStatus       @default(PENDING)
  vehicleOwnersNidRejectionReason String?
  isDLVerified                    VerificationStatus       @default(PENDING)
  dlRejectionReason               String?
  isRCVerified                    VerificationStatus       @default(PENDING)
  rcRejectionReason               String?
  isNumberPlateVerified           VerificationStatus       @default(PENDING)
  numberPlateRejectionReason      String?
  isTaxTokenVerified              VerificationStatus       @default(PENDING)
  taxTokenRejectionReason         String?
  isPanCardVerified               VerificationStatus       @default(PENDING)
  isAadhaarVerified               VerificationStatus       @default(PENDING)
  isFairCoinAvailed               Boolean                  @default(false)
  currentLocation                 Json?
  panCardName                     String?
  aadhaarName                     String?
  panCardNumber                   String?                  @unique
  aadhaarCardNumber               String?                  @unique
  aadhaarCardAddress              String?
  pilotCouponId                   String?
  promoterId                      String?
  createdAt                       DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime                 @updatedAt @db.Timestamptz(6)
  city                            String?
  name                            String?
  currentRank                     Int?
  lastRankUpdate                  DateTime?
  monthlyEarnings                 Decimal                  @default(0) @db.Decimal(10, 2)
  pilotType                       PilotType?               @default(REGULAR)
  primaryVehicleTypeId            String?
  starPilotSince                  DateTime?
  superPilotSince                 DateTime?
  totalLifetimeEarnings           Decimal                  @default(0) @db.Decimal(10, 2)
  totalLifetimeRides              Int                      @default(0)
  weeklyEarnings                  Decimal                  @default(0) @db.Decimal(10, 2)
  bookings                        Booking[]
  drivingLicense                  DrivingLicense?
  nid                             Nid?                     @relation("PilotNid")
  activeBooking                   Booking?                 @relation("PilotActiveBooking", fields: [activeBookingId], references: [id])
  language                        Languages                @relation(fields: [languageId], references: [id])
  pilotCoupon                     PilotCoupon?             @relation(fields: [pilotCouponId], references: [id])
  pilotProgram                    PilotProgram?            @relation(fields: [pilotProgramId], references: [id])
  primaryVehicleType              VehicleTypeBD?           @relation(fields: [primaryVehicleTypeId], references: [id])
  promoter                        Promoter?                @relation(fields: [promoterId], references: [id])
  user                            User                     @relation(fields: [userId], references: [id])
  pilotAchievements               PilotAchievement[]
  pilotProgramEnrollments         PilotProgramEnrollment[]
  pilotRankings                   PilotRanking[]
  ratings                         PilotRating[]
  pilotTrips                      PilotTrips[]
  wallet                          PilotWallet?
  transaction                     Transaction[]
  vehicle                         Vehicle?                 @relation("PilotVehicle")
  videoProgress                   VideoProgress?
}

model PilotCoupon {
  id             String        @id @default(uuid())
  name           String        @unique
  description    String?
  subscriptionId String?
  validUntil     DateTime?     @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  discount       Decimal       @default(0.00) @db.Decimal(10, 2)
  pilots         Pilot[]
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
}

model Nid {
  pilotId                    String    @id @unique
  nidNumber                  String?   @unique
  name                       String?
  dateOfBirth                DateTime?
  vehicleOwnerNidNumber      String?
  vehicleOwnerNidName        String?
  vehicleOwnerNidDateOfBirth DateTime?
  pilot                      Pilot     @relation("PilotNid", fields: [pilotId], references: [id])
}

model DrivingLicense {
  id               String    @id @default(uuid())
  pilotId          String    @unique
  licenseNumber    String    @unique
  nameOnLicense    String
  dateOfBirth      DateTime
  dateOfIssue      DateTime?
  validUntill      DateTime
  permanentAddress String?
  temporaryAddress String?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  pilot            Pilot     @relation(fields: [pilotId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id               String         @id @default(uuid())
  pilotId          String         @unique
  regNo            String         @unique
  fitUpto          DateTime?
  insuranceUpto    DateTime?
  puccUpto         DateTime?
  regUpto          DateTime?
  permitUpto       DateTime?
  registrationDate DateTime?
  expiryDate       DateTime?
  manufacturer     String?
  status           String?
  colour           String
  model            String?
  state            String?
  seatCapacity     String?
  vehicleTypeId    String?
  vehicleTypeIdBD  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  bookings         Booking[]
  pilot            Pilot          @relation("PilotVehicle", fields: [pilotId], references: [id])
  vehicleTypeBD    VehicleTypeBD? @relation(fields: [vehicleTypeIdBD], references: [id])
  vehicleType      VehicleType?   @relation(fields: [vehicleTypeId], references: [id])
}

model VehicleType {
  id                String          @id @default(uuid())
  name              VehicleTypeName @unique
  airCondition      String[]
  isFaster          Boolean
  passengerCapacity Int
  baseFare          Decimal?        @db.Decimal(10, 2)
  perKmRate         Decimal?        @db.Decimal(10, 2)
  perMinRate        Decimal?        @db.Decimal(10, 2)
  vehicle           Vehicle[]
}

model VehicleTypeBD {
  id                String            @id @default(uuid())
  name              VehicleTypeNameBD @unique
  serialNumber      Int?
  airCondition      String[]
  isFaster          Boolean
  passengerCapacity Int
  baseFare          Decimal?          @db.Decimal(10, 2)
  perKmRate         Decimal?          @db.Decimal(10, 2)
  perMinRate        Decimal?          @db.Decimal(10, 2)
  minFare           Decimal?          @db.Decimal(10, 2)
  insuranceFee      Decimal?          @db.Decimal(10, 2)
  bookings          Booking[]
  pilots            Pilot[]
  pilotRankings     PilotRanking[]
  tariffs           Tariff[]
  vehicle           Vehicle[]
}

model VehicleClassificationCache {
  id              String   @id @default(uuid())
  category        String
  class           String
  manufacturer    String
  model           String
  bodyType        String?
  vehicleCategory String?
  seatCapacity    String?
  permitType      String?
  isCommercial    Boolean
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@unique([class, manufacturer, model, bodyType, vehicleCategory, seatCapacity, permitType, isCommercial])
}

model Tariff {
  id              String        @id @default(uuid())
  city            String
  intercity       Boolean       @default(false)
  vehicleTypeBDId String
  baseFare        Decimal       @db.Decimal(10, 2)
  perKmRate       Decimal       @db.Decimal(10, 2)
  perMinRate      Decimal       @db.Decimal(10, 2)
  minFare         Decimal       @db.Decimal(10, 2)
  insuranceFee    Decimal       @db.Decimal(10, 2)
  pickupFee       Decimal?      @db.Decimal(10, 2)
  pickupActive    Boolean       @default(false)
  version         Int           @default(1)
  effectiveFrom   DateTime      @db.Timestamptz(6)
  effectiveTo     DateTime?     @db.Timestamptz(6)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)
  vehicleTypeBD   VehicleTypeBD @relation(fields: [vehicleTypeBDId], references: [id])

  @@index([city, intercity, vehicleTypeBDId, isActive])
}

model Subscription {
  id                  String        @id @default(uuid())
  name                String        @unique
  serialNumber        Int?
  quantifier          String?
  coins               Decimal       @db.Decimal(10, 2)
  price               Decimal       @db.Decimal(10, 2)
  priceBeforeDiscount Decimal?      @db.Decimal(10, 2)
  tag                 String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  pilotCoupons        PilotCoupon[]
  wallets             PilotWallet[]
  transactions        Transaction[]
}

model PilotTrips {
  id        String   @id @default(uuid())
  pilotId   String
  bookingId String
  date      DateTime @db.Timestamptz(6)
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  pilot     Pilot    @relation(fields: [pilotId], references: [id])

  @@index([pilotId, date])
}

model PilotWallet {
  id                       String        @id @default(uuid())
  pilotId                  String        @unique
  balance                  Decimal       @db.Decimal(10, 2)
  minusLimit               Decimal       @default(100.00) @db.Decimal(10, 2)
  todaysEarning            Decimal?      @default(0.00) @db.Decimal(10, 2)
  lastTripEarning          Decimal?      @default(0.00) @db.Decimal(10, 2)
  subscriptionId           String
  autoRechargeEnabled      Boolean?      @default(true)
  autoRechargeEnabledUntil DateTime?     @db.Timestamptz(6)
  autoRechargeAmount       Decimal?      @default(0.00) @db.Decimal(10, 2)
  autoRechargeDate         DateTime?     @db.Timestamptz(6)
  date                     DateTime?     @db.Timestamptz(6)
  createdAt                DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime      @updatedAt @db.Timestamptz(6)
  pilot                    Pilot         @relation(fields: [pilotId], references: [id])
  subscription             Subscription  @relation(fields: [subscriptionId], references: [id])
  transactions             Transaction[]
}

model Transaction {
  id             String            @id @default(uuid())
  pilotId        String
  walletId       String?
  order_id       String?
  status         TransactionStatus
  type           TransactionType
  amount         Decimal           @db.Decimal(10, 2)
  balanceBefore  Decimal?          @db.Decimal(10, 2)
  balanceAfter   Decimal?          @db.Decimal(10, 2)
  metadata       Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)
  subscriptionId String?
  pilot          Pilot             @relation(fields: [pilotId], references: [id])
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id])
  pilotWallet    PilotWallet?      @relation(fields: [walletId], references: [id])
}

model Booking {
  id                 String              @id @default(uuid())
  bookingCode        String
  customerId         String
  pilotId            String?
  name               String
  status             BookingStatus
  rideType           RideType
  vehicleId          String?
  estimatedFare      Decimal             @db.Decimal(10, 2)
  discountedFare     Decimal             @db.Decimal(10, 2)
  tripEndFare        Decimal?            @db.Decimal(10, 2)
  pickupLocation     Json
  dropLocation       Json
  estimatedDistance  String
  distance           String?
  estimatedDuration  Int
  duration           String?
  acceptedAt         DateTime?           @db.Timestamptz(6)
  arrivedAt          DateTime?           @db.Timestamptz(6)
  tripStart          DateTime?           @db.Timestamptz(6)
  tripEnd            DateTime?           @db.Timestamptz(6)
  surgeMultiplier    Decimal?            @default(1.0) @db.Decimal(10, 2)
  notes              String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  vehicleTypeIdBD    String?
  customer           Customer            @relation(fields: [customerId], references: [id])
  pilot              Pilot?              @relation(fields: [pilotId], references: [id])
  vehicle            Vehicle?            @relation(fields: [vehicleId], references: [id])
  vehicleTypeBD      VehicleTypeBD?      @relation(fields: [vehicleTypeIdBD], references: [id])
  cancellationReason CancellationReason?
  activeCustomer     Customer?           @relation("CustomerActiveBooking")
  customerRating     CustomerRating?
  message            Message[]
  activePilot        Pilot?              @relation("PilotActiveBooking")
  pilotRating        PilotRating?
  supportTicket      SupportTicket[]

  @@index([customerId, status])
  @@index([pilotId, status])
  @@index([tripStart])
}

model CancellationReason {
  id          String      @id @default(uuid())
  reason      String
  cancelledBy CancelledBy
  bookingId   String      @unique
  supportId   String?
  booking     Booking     @relation(fields: [bookingId], references: [id])
  support     Support?    @relation(fields: [supportId], references: [id])
}

model Message {
  id        String   @id @default(uuid())
  bookingId String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

model CustomerRating {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  customerId String
  rating     Int      @db.SmallInt
  feedback   String?
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
}

model PilotProgram {
  id          String                   @id @default(uuid())
  name        String                   @unique
  description String?
  createdAt   DateTime                 @default(now())
  criteria    Json
  endDate     DateTime?
  isActive    Boolean                  @default(true)
  programType ProgramType
  rewardType  String?
  rewardValue String?
  startDate   DateTime
  updatedAt   DateTime                 @updatedAt
  pilot       Pilot[]
  enrollments PilotProgramEnrollment[]
}

model PilotProgramEnrollment {
  id                String       @id @default(uuid())
  pilotId           String
  programId         String
  enrolledAt        DateTime     @default(now())
  achievedAt        DateTime?
  isCurrentlyActive Boolean      @default(false)
  pilot             Pilot        @relation(fields: [pilotId], references: [id])
  program           PilotProgram @relation(fields: [programId], references: [id])

  @@unique([pilotId, programId])
}

model PilotRanking {
  id            String        @id @default(uuid())
  pilotId       String
  calculatedAt  DateTime      @default(now())
  earnings      Decimal       @db.Decimal(10, 2)
  rank          Int           @default(0)
  rankingPeriod RankingPeriod
  rides         Int
  totalPilots   Int
  vehicleTypeId String
  pilot         Pilot         @relation(fields: [pilotId], references: [id])
  vehicleType   VehicleTypeBD @relation(fields: [vehicleTypeId], references: [id])

  @@unique([pilotId, rankingPeriod, calculatedAt, vehicleTypeId])
  @@index([rank])
  @@index([rankingPeriod, calculatedAt])
  @@index([vehicleTypeId, rankingPeriod, calculatedAt, rank])
}

model Achievement {
  id                String              @id @default(uuid())
  name              String              @unique
  description       String?
  category          AchievementCategory
  rarity            AchievementRarity
  criteria          Json
  rewardType        String?
  rewardValue       String?
  iconUrl           String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  pilotAchievements PilotAchievement[]
}

model PilotAchievement {
  id            String      @id @default(uuid())
  pilotId       String
  achievementId String
  earnedAt      DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  pilot         Pilot       @relation(fields: [pilotId], references: [id])

  @@unique([pilotId, achievementId])
}

model PilotRating {
  id        String   @id @default(uuid())
  bookingId String   @unique
  pilotId   String
  rating    Int      @db.SmallInt
  feedback  String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  pilot     Pilot    @relation(fields: [pilotId], references: [id])
}

model SupportTicket {
  id            String         @id @default(uuid())
  userId        String
  bookingId     String
  type          SupportType
  channel       SupportChannel @default(CHAT)
  status        SupportStatus  @default(OPEN)
  description   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assignedAt    DateTime?      @db.Timestamptz(6)
  evidenceUrl   String[]
  notes         Json?
  resolvedAt    DateTime?      @db.Timestamptz(6)
  supportId     String?
  whatsAppPhone String?
  booking       Booking        @relation(fields: [bookingId], references: [id])
  support       Support?       @relation(fields: [supportId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
}

model Languages {
  id           String        @id @default(uuid())
  name         String        @unique
  customers    Customer[]
  pilots       Pilot[]
  translations Translation[]
}

model Translation {
  id         String    @id @default(uuid())
  languageId String
  key        String
  content    String
  category   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  language   Languages @relation(fields: [languageId], references: [id])

  @@unique([languageId, key])
}

model Policy {
  id        String   @id @default(uuid())
  type      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoTutorial {
  id         String          @id @default(uuid())
  title      String
  videoUrl   String
  duration   Int
  order      Int
  isRequired Boolean         @default(false)
  progress   VideoProgress[]
}

model VideoProgress {
  id        String        @id @default(uuid())
  pilotId   String        @unique
  videoId   String
  completed Boolean       @default(false)
  pilot     Pilot         @relation(fields: [pilotId], references: [id])
  video     VideoTutorial @relation(fields: [videoId], references: [id])

  @@unique([pilotId, videoId])
}

model Announcement {
  id          String                 @id @default(uuid())
  title       String
  message     String
  audience    AnnouncementAudience
  schedule    DateTime?              @db.Timestamptz(6)
  bannerUrl   String?
  impressions Int                    @default(0)
  createdBy   String
  status      AnnouncementStatus     @default(DRAFT)
  createdAt   DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(6)
  deliveries  AnnouncementDelivery[]
}

model AnnouncementDelivery {
  id             String             @id @default(uuid())
  announcementId String
  userId         String
  sentAt         DateTime           @db.Timestamptz(6)
  viewedAt       DateTime?          @db.Timestamptz(6)
  status         AnnouncementStatus @default(SCHEDULED)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)
  announcement   Announcement       @relation(fields: [announcementId], references: [id])
  user           User               @relation(fields: [userId], references: [id])
}

