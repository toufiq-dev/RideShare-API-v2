generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid())
  email           String?         @unique
  isEmailVerified Boolean?        @default(false)
  isPhoneVerified Boolean         @default(false)
  name            String?
  referralCode    String?
  role            UserRole
  status          UserStatus      @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastLogin       DateTime?
  metadata        Json?
  admin           Admin?
  customer        Customer?
  deviceTokens    DeviceToken[]
  pilot           Pilot?
  support         Support?
  supportTickets  SupportTicket[]
  transaction     Transaction[]
  session         UserSession[]
}

model UserSession {
  id         String  @id @default(uuid())
  userId     String
  deviceInfo String?
  ipAddress  String?
  isActive   Boolean @default(true)
  location   Json?
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([location])
}

model DeviceToken {
  id              String   @id @default(uuid())
  userId          String
  token           String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  appVersion      String
  dateTime        String
  platform        String
  platformVersion String
  user            User     @relation(fields: [userId], references: [id])
}

model Admin {
  id       String @id @default(uuid())
  name     String
  userId   String @unique
  email    String @unique
  password String
  user     User   @relation(fields: [userId], references: [id])
}

model Customer {
  id          String           @id @default(uuid())
  userId      String           @unique
  avatar      String?
  languageId  String
  phone       String           @unique
  bookings    Booking[]
  language    Languages        @relation(fields: [languageId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
  ratings     CustomerRating[]
  savedPlaces SavedPlace[]

  @@index([phone])
}

model SavedPlace {
  id         String         @id @default(uuid())
  customerId String
  name       String?
  address    String
  type       SavedPlaceType @default(OTHERS)
  location   Json?
  customer   Customer       @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model Support {
  id           String @id @default(uuid())
  userId       String @unique
  email        String @unique
  password     String
  referralCode String
  user         User   @relation(fields: [userId], references: [id])
}

model Pilot {
  id                 String          @id @default(uuid())
  userId             String          @unique
  isAvailable        Boolean         @default(false)
  totalTrips         Int             @default(0)
  averageRating      Float           @default(0)
  isAadharVerified   Boolean         @default(false)
  languageId         String
  phone              String          @unique
  pilotProgramId     String?
  selfieUrl          String?
  acceptedTerms      Boolean         @default(true)
  isDLVerified       Boolean         @default(false)
  isPanCardVerified  Boolean         @default(false)
  isRCVerified       Boolean         @default(false)
  isAadhaarVerified  Boolean         @default(false)
  isFairCoinAvailed  Boolean         @default(false)
  currentLocation    Json?
  panCardName        String?
  aadhaarName        String?
  panCardNumber      String?         @unique
  aadhaarCardNumber  String?         @unique
  aadhaarCardAddress String?
  bookings           Booking[]
  drivingLicense     DrivingLicense?
  language           Languages       @relation(fields: [languageId], references: [id])
  pilotProgram       PilotProgram?   @relation(fields: [pilotProgramId], references: [id])
  user               User            @relation(fields: [userId], references: [id])
  earnings           PilotEarning[]
  ranking            PilotRanking?
  ratings            PilotRating[]
  wallet             PilotWallet?
  vehicles           Vehicle[]
  videoProgress      VideoProgress?

  @@index([isAvailable])
}

model DrivingLicense {
  id               String   @id @default(uuid())
  pilotId          String   @unique
  licenseNumber    String   @unique
  nameOnLicense    String
  dateOfBirth      DateTime
  dateOfIssue      DateTime
  validUntill      DateTime
  permanentAddress String?
  temporaryAddress String?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  pilot            Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@index([licenseNumber])
}

model Vehicle {
  id            String      @id @default(uuid())
  pilotId       String
  regNo         String      @unique
  fitUpto       DateTime
  insuranceUpto DateTime
  puccUpto      DateTime
  regUpto       DateTime
  permitUpto    DateTime
  manufacturer  String
  status        String
  vehicleTypeId String
  colour        String
  model         String
  state         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  pilot         Pilot       @relation(fields: [pilotId], references: [id])
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])
}

model VehicleType {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  vehicle     Vehicle[]
}

model PilotProgram {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  pilot       Pilot[]
}

model PilotRanking {
  id      String @id @default(uuid())
  pilotId String @unique
  ranking Int    @default(0)
  pilot   Pilot  @relation(fields: [pilotId], references: [id])
}

model Languages {
  id           String        @id @default(uuid())
  name         String        @unique
  customers    Customer[]
  pilots       Pilot[]
  translations Translation[]
}

model Translation {
  id         String    @id @default(uuid())
  languageId String
  key        String
  content    String
  category   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  language   Languages @relation(fields: [languageId], references: [id])

  @@unique([languageId, key])
}

model PilotWallet {
  id             String        @id @default(uuid())
  pilotId        String        @unique
  balance        Int
  minusLimit     Int           @default(-100)
  lastRecharge   DateTime?
  subscriptionId String
  pilot          Pilot         @relation(fields: [pilotId], references: [id])
  transactions   Transaction[]
}

model Transaction {
  id             String                   @id @default(uuid())
  userId         String
  walletId       String?
  type           TransactionType
  amount         Decimal
  bookingId      String?
  metadata       Json?
  createdAt      DateTime                 @default(now())
  subscriptionId String?
  booking        Booking?                 @relation(fields: [bookingId], references: [id])
  subscriptionTx SubscriptionTransaction? @relation(fields: [subscriptionId], references: [id])
  user           User                     @relation(fields: [userId], references: [id])
  pilotWallet    PilotWallet?             @relation(fields: [walletId], references: [id])
}

model PilotSubscription {
  id           String                    @id @default(uuid())
  name         String                    @unique
  coins        Int
  transactions SubscriptionTransaction[]
}

model PilotEarning {
  id          String   @id @default(uuid())
  pilotId     String
  amount      Decimal
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  lastUpdated DateTime
  pilot       Pilot    @relation(fields: [pilotId], references: [id])
}

model SubscriptionTransaction {
  id             String            @id @default(uuid())
  subscriptionId String
  amount         Decimal
  status         PaymentStatus
  paymentMethod  String
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  subscription   PilotSubscription @relation(fields: [subscriptionId], references: [id])
  transaction    Transaction[]
}

model Booking {
  id                   String              @id @default(uuid())
  bookingCode          String              @unique
  customerId           String
  pilotId              String?
  riderName            String?
  riderPhone           String?
  actualDistance       Float?
  actualDuration       Int?
  tripStart            DateTime?
  tripEnd              DateTime?
  status               BookingStatus
  estimatedFare        Float?
  fare                 Float?
  surgeMultiplier      Float?              @default(1.0)
  discount             Float?              @default(0.0)
  duration             Int?
  notes                String?
  scheduledFor         DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  cancellationReasonId String?
  pickupLocation       Json
  dropLocation         Json
  cancellationReason   CancellationReason? @relation(fields: [cancellationReasonId], references: [id])
  customer             Customer            @relation(fields: [customerId], references: [id])
  pilot                Pilot?              @relation(fields: [pilotId], references: [id])
  customerRating       CustomerRating?
  payment              Payment?
  pilotRating          PilotRating?
  supportTicket        SupportTicket?
  walletTransactions   Transaction[]

  @@index([customerId])
  @@index([pilotId])
  @@index([status, createdAt])
}

model CancellationReason {
  id        String    @id @default(uuid())
  reason    String
  bookingId String
  booking   Booking[]
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  amount        Decimal
  status        PaymentStatus
  paymentMethod String
  transactionId String?
  createdAt     DateTime      @default(now())
  metadata      Json?
  booking       Booking       @relation(fields: [bookingId], references: [id])

  @@index([status])
  @@index([createdAt])
}

model CustomerRating {
  id         String    @id @default(uuid())
  bookingId  String    @unique
  customerId String
  rating     Int       @db.SmallInt
  comment    String?
  createdAt  DateTime  @default(now())
  booking    Booking   @relation(fields: [bookingId], references: [id])
  customer   Customer  @relation(fields: [customerId], references: [id])
  feedback   Feedback?
}

model PilotRating {
  id        String     @id @default(uuid())
  bookingId String     @unique
  pilotId   String
  rating    Int        @db.SmallInt
  comment   String?
  createdAt DateTime   @default(now())
  feedback  Feedback[]
  booking   Booking    @relation(fields: [bookingId], references: [id])
  pilot     Pilot      @relation(fields: [pilotId], references: [id])
}

model Feedback {
  id               String         @id @default(uuid())
  ratingId         String?
  customerRatingId String         @unique
  pilotRatingId    String
  tags             String[]
  comment          String?
  createdAt        DateTime       @default(now())
  customerRating   CustomerRating @relation(fields: [customerRatingId], references: [id])
  pilotRating      PilotRating    @relation(fields: [pilotRatingId], references: [id])
}

model SupportTicket {
  id          String         @id @default(uuid())
  userId      String
  bookingId   String?        @unique
  type        SupportType
  channel     SupportChannel
  status      SupportStatus  @default(OPEN)
  description String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  booking     Booking?       @relation(fields: [bookingId], references: [id])
  user        User           @relation(fields: [userId], references: [id])
}

model Policy {
  id        String   @id @default(uuid())
  type      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoTutorial {
  id         String          @id @default(uuid())
  title      String
  videoUrl   String
  duration   Int
  order      Int
  isRequired Boolean         @default(false)
  progress   VideoProgress[]
}

model VideoProgress {
  id        String        @id @default(uuid())
  pilotId   String        @unique
  videoId   String
  completed Boolean       @default(false)
  pilot     Pilot         @relation(fields: [pilotId], references: [id])
  video     VideoTutorial @relation(fields: [videoId], references: [id])

  @@unique([pilotId, videoId])
}

enum UserRole {
  ADMIN
  CUSTOMER
  PILOT
  SUPPORT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum DocumentType {
  DRIVING_LICENSE
  VEHICLE_REGISTRATION
  INSURANCE
  AADHAR_CARD
  PAN_CARD
  PROFILE_PHOTO
  PUCC
  FITNESS_CERTIFICATE
  OTHER
}

enum BookingStatus {
  PENDING
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionType {
  SUBSCRIPTION_PURCHASE
  TRIP_DEDUCTION
  REFUND
  BONUS
  CUSTOMER_PAYMENT
  CUSTOMER_REFUND
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SupportType {
  GENERAL_INQUIRY
  BOOKING_ISSUE
  PAYMENT_ISSUE
  TECHNICAL_SUPPORT
  COMPLAINT
  OTHER
}

enum SupportChannel {
  EMAIL
  CHAT
  PHONE
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SavedPlaceType {
  HOME
  WORK
  RESTAURANT
  GYM
  COLLEGE
  OTHERS
}
