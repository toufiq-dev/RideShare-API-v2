generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid())
  phone           String          @unique
  email           String?         @unique
  isEmailVerified Boolean?        @default(false)
  isPhoneVerified Boolean         @default(false)
  name            String?
  avatar          String?
  referralCode    String?
  role            UserRole
  status          UserStatus      @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastLogin       DateTime?
  metadata        Json?
  admin           Admin?
  customer        Customer?
  deviceTokens    DeviceToken[]
  pilot           Pilot?
  support         Support?
  supportTickets  SupportTicket[]
  transaction     Transaction[]
  session         UserSession[]

  @@index([phone])
}

model UserSession {
  id         String  @id @default(uuid())
  userId     String
  deviceInfo String?
  ipAddress  String?
  location   String?
  isActive   Boolean @default(true)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([location])
}

model DeviceToken {
  id         String     @id @default(uuid())
  userId     String
  token      String     @unique
  deviceType DeviceType
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id])
}

model Admin {
  id       String @id @default(uuid())
  name     String
  userId   String @unique
  email    String @unique
  password String
  user     User   @relation(fields: [userId], references: [id])
}

model Customer {
  id          String           @id @default(uuid())
  userId      String           @unique
  languageId  String
  bookings    Booking[]
  language    Languages        @relation(fields: [languageId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
  ratings     CustomerRating[]
  savedPlaces SavedPlace[]

  @@index([userId])
}

model SavedPlace {
  id         String   @id @default(uuid())
  customerId String
  name       String
  type       String
  address    String
  location   Json
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, type])
  @@index([customerId])
}

model Support {
  id           String @id @default(uuid())
  userId       String @unique
  email        String @unique
  password     String
  referralCode String
  user         User   @relation(fields: [userId], references: [id])
}

model Pilot {
  id                     String             @id @default(uuid())
  languageId             String
  userId                 String             @unique
  hasAcceptedTerms       Boolean            @default(false)
  selfieUrl              String?
  drivingLicense         String?            @unique
  dateOfBirth            DateTime?
  providedDrivingLicense Boolean            @default(false)
  providedRC             Boolean            @default(false)
  panCardName            String?
  panCardNumber          String?
  providedPanCard        Boolean            @default(false)
  isAadharVerified       Boolean            @default(false)
  currentLocation        Json?
  subscriptionId         String?
  totalTrips             Int                @default(0)
  averageRating          Float              @default(0)
  isAvailable            Boolean            @default(false)
  pilotProgramId         String?
  pilotProgram           PilotProgram?      @relation(fields: [pilotProgramId], references: [id])
  vehicles               Vehicle[]
  bookings               Booking[]
  documents              Document[]
  language               Languages          @relation(fields: [languageId], references: [id])
  subscription           PilotSubscription? @relation(fields: [subscriptionId], references: [id])
  user                   User               @relation(fields: [userId], references: [id])
  earnings               PilotEarning[]
  ranking                PilotRanking?
  ratings                PilotRating[]
  wallet                 PilotWallet?
  videoProgress          VideoProgress?

  @@index([isAvailable, currentLocation])
}

model PilotProgram {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  pilot       Pilot[]
}

model PilotRanking {
  id      String @id @default(uuid())
  pilotId String @unique
  ranking Int    @default(0)
  pilot   Pilot  @relation(fields: [pilotId], references: [id])
}

model Languages {
  id           String        @id @default(uuid())
  name         String        @unique
  customers    Customer[]
  pilots       Pilot[]
  translations Translation[]
}

model Translation {
  id         String    @id @default(uuid())
  languageId String
  key        String
  content    String
  category   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  language   Languages @relation(fields: [languageId], references: [id])

  @@unique([languageId, key])
}

model Vehicle {
  id                 String       @id @default(uuid())
  pilotId            String
  manufacturer       String?
  model              String?
  year               Int?
  rcNumber           String       @unique
  color              String
  capacity           Int
  vehicleTypeId      String?
  registrationExpiry DateTime?
  permitExpiry       DateTime?
  insuranceExpiry    DateTime?
  pilot              Pilot        @relation(fields: [pilotId], references: [id])
  vehicleType        VehicleType? @relation(fields: [vehicleTypeId], references: [id])
  documents          Document[]
}

model VehicleType {
  id      String    @id @default(uuid())
  name    String    @unique
  vehicle Vehicle[]
}

model PilotWallet {
  id           String        @id @default(uuid())
  pilotId      String        @unique
  balance      Int
  minusLimit   Int           @default(-100)
  lastRecharge DateTime?
  pilot        Pilot         @relation(fields: [pilotId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  walletId    String?
  type        TransactionType
  amount      Decimal
  description String?
  bookingId   String?
  metadata    Json?
  createdAt   DateTime        @default(now())
  booking     Booking?        @relation(fields: [bookingId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
  pilotWallet PilotWallet?    @relation(fields: [walletId], references: [id])
}

model PilotSubscription {
  id                 String                    @id @default(uuid())
  subscriptionTypeId String                    @unique
  price              Decimal
  coins              Int
  description        String
  features           Json
  isActive           Boolean                   @default(true)
  pilots             Pilot[]
  transactions       SubscriptionTransaction[]
  subscriptionType   SubscriptionType          @relation(fields: [subscriptionTypeId], references: [id])
}

model SubscriptionType {
  id                String              @id @default(uuid())
  name              String              @unique
  pilotSubscription PilotSubscription[]
}

model PilotEarning {
  id          String   @id @default(uuid())
  pilotId     String
  amount      Decimal
  date        DateTime
  description String?
  lastUpdated DateTime
  createdAt   DateTime @default(now())
  pilot       Pilot    @relation(fields: [pilotId], references: [id])
}

model SubscriptionTransaction {
  id             String            @id @default(uuid())
  subscriptionId String
  amount         Decimal
  status         PaymentStatus
  paymentMethod  String
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime          @default(now())
  subscription   PilotSubscription @relation(fields: [subscriptionId], references: [id])
}

model Booking {
  id                   String              @id @default(uuid())
  bookingCode          String              @unique
  customerId           String
  pilotId              String?
  riderName            String?
  riderPhone           String?
  pickupLocation       Json
  dropLocation         Json
  actualDistance       Float?
  actualDuration       Int?
  tripStart            DateTime?
  tripEnd              DateTime?
  status               BookingStatus
  estimatedFare        Float?
  fare                 Float?
  surgeMultiplier      Float?              @default(1.0)
  discount             Float?              @default(0.0)
  duration             Int?
  cancellationReasonId String?
  notes                String?
  scheduledFor         DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  customer             Customer            @relation(fields: [customerId], references: [id])
  pilot                Pilot?              @relation(fields: [pilotId], references: [id])
  cancellationReason   CancellationReason? @relation(fields: [cancellationReasonId], references: [id])
  customerRating       CustomerRating?
  payment              Payment?
  pilotRating          PilotRating?
  supportTicket        SupportTicket?
  walletTransactions   Transaction[]

  @@index([customerId])
  @@index([pilotId])
  @@index([status, createdAt])
}

model CancellationReason {
  id        String    @id @default(uuid())
  reason    String
  bookingId String
  booking   Booking[]
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  amount        Decimal
  status        PaymentStatus
  paymentMethod String
  transactionId String?
  createdAt     DateTime      @default(now())
  metadata      Json?
  booking       Booking       @relation(fields: [bookingId], references: [id])

  @@index([status])
  @@index([createdAt])
}

model CustomerRating {
  id         String    @id @default(uuid())
  bookingId  String    @unique
  customerId String
  rating     Int       @db.SmallInt
  comment    String?
  createdAt  DateTime  @default(now())
  booking    Booking   @relation(fields: [bookingId], references: [id])
  customer   Customer  @relation(fields: [customerId], references: [id])
  feedback   Feedback?
}

model PilotRating {
  id        String     @id @default(uuid())
  bookingId String     @unique
  pilotId   String
  rating    Int        @db.SmallInt
  comment   String?
  createdAt DateTime   @default(now())
  feedback  Feedback[]
  booking   Booking    @relation(fields: [bookingId], references: [id])
  pilot     Pilot      @relation(fields: [pilotId], references: [id])
}

model Feedback {
  id               String         @id @default(uuid())
  ratingId         String?
  customerRatingId String         @unique
  pilotRatingId    String
  tags             String[]
  comment          String?
  createdAt        DateTime       @default(now())
  customerRating   CustomerRating @relation(fields: [customerRatingId], references: [id])
  pilotRating      PilotRating    @relation(fields: [pilotRatingId], references: [id])
}

model SupportTicket {
  id          String         @id @default(uuid())
  userId      String
  bookingId   String?        @unique
  type        SupportType
  channel     SupportChannel
  status      SupportStatus  @default(OPEN)
  description String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  booking     Booking?       @relation(fields: [bookingId], references: [id])
  user        User           @relation(fields: [userId], references: [id])
}

model Document {
  id           String       @id @default(uuid())
  pilotId      String
  vehicleId    String
  type         DocumentType
  documentUrl  String
  expiryDate   DateTime?
  alertMessage String
  isVerified   Boolean      @default(false)
  uploadedAt   DateTime     @default(now())
  pilot        Pilot        @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id])
}

model VideoTutorial {
  id         String          @id @default(uuid())
  title      String
  videoUrl   String
  duration   Int
  order      Int
  isRequired Boolean         @default(false)
  progress   VideoProgress[]
}

model VideoProgress {
  id        String        @id @default(uuid())
  pilotId   String        @unique
  videoId   String
  completed Boolean       @default(false)
  pilot     Pilot         @relation(fields: [pilotId], references: [id])
  video     VideoTutorial @relation(fields: [videoId], references: [id])

  @@unique([pilotId, videoId])
}

enum DeviceType {
  IOS
  ANDROID
}

enum UserRole {
  ADMIN
  CUSTOMER
  PILOT
  SUPPORT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum DocumentType {
  DRIVING_LICENSE
  VEHICLE_REGISTRATION
  INSURANCE
  AADHAR_CARD
  PAN_CARD
  PROFILE_PHOTO
  PUCC
  FITNESS_CERTIFICATE
  OTHER
}

enum BookingStatus {
  PENDING
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionType {
  SUBSCRIPTION_PURCHASE
  TRIP_DEDUCTION
  REFUND
  BONUS
  CUSTOMER_PAYMENT
  CUSTOMER_REFUND
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SupportType {
  GENERAL_INQUIRY
  BOOKING_ISSUE
  PAYMENT_ISSUE
  TECHNICAL_SUPPORT
  COMPLAINT
  OTHER
}

enum SupportChannel {
  EMAIL
  CHAT
  PHONE
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
