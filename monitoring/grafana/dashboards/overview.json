{
    "dashboard": {
      "id": null,
      "title": "FairDrive API - Overview Dashboard",
      "tags": ["fairdrive", "overview", "summary"],
      "timezone": "browser",
      "schemaVersion": 16,
      "version": 0,
      "refresh": "1m",
      "time": {
        "from": "now-6h",
        "to": "now"
      },
      "panels": [
        {
          "id": 1,
          "title": "Request Rate",
          "type": "stat",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 0,
            "y": 0
          },
          "targets": [
            {
              "expr": "sum(rate(fairdrive_http_requests_total[5m]))",
              "refId": "A"
            }
          ],
          "options": {
            "graphMode": "area",
            "colorMode": "value",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
              "values": false,
              "calcs": ["lastNotNull"],
              "fields": ""
            },
            "textMode": "auto",
            "unit": "reqps"
          }
        },
        {
          "id": 2,
          "title": "Error Rate",
          "type": "stat",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 6,
            "y": 0
          },
          "targets": [
            {
              "expr": "sum(rate(fairdrive_http_errors_total[5m]))",
              "refId": "A"
            }
          ],
          "options": {
            "graphMode": "area",
            "colorMode": "thresholds",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
              "values": false,
              "calcs": ["lastNotNull"],
              "fields": ""
            },
            "textMode": "auto",
            "unit": "ops"
          },
          "fieldConfig": {
            "defaults": {
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 0.01
                  },
                  {
                    "color": "red",
                    "value": 0.1
                  }
                ]
              }
            }
          }
        },
        {
          "id": 3,
          "title": "P95 Response Time",
          "type": "stat",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 12,
            "y": 0
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.95, rate(fairdrive_http_request_duration_seconds_bucket[5m]))",
              "refId": "A"
            }
          ],
          "options": {
            "graphMode": "area",
            "colorMode": "thresholds",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
              "values": false,
              "calcs": ["lastNotNull"],
              "fields": ""
            },
            "textMode": "auto",
            "unit": "s"
          },
          "fieldConfig": {
            "defaults": {
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 1
                  },
                  {
                    "color": "red",
                    "value": 2
                  }
                ]
              },
              "decimals": 2
            }
          }
        },
        {
          "id": 4,
          "title": "Active Rides",
          "type": "stat",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 18,
            "y": 0
          },
          "targets": [
            {
              "expr": "sum(increase(fairdrive_ride_completions_total[1h]))",
              "refId": "A"
            }
          ],
          "options": {
            "graphMode": "area",
            "colorMode": "value",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
              "values": false,
              "calcs": ["lastNotNull"],
              "fields": ""
            },
            "textMode": "auto"
          }
        },
        {
          "id": 5,
          "title": "System Health",
          "type": "stat",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 0,
            "y": 4
          },
          "targets": [
            {
              "expr": "up",
              "refId": "A"
            }
          ],
          "options": {
            "graphMode": "none",
            "colorMode": "thresholds",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
              "values": false,
              "calcs": ["lastNotNull"],
              "fields": ""
            },
            "textMode": "auto"
          },
          "fieldConfig": {
            "defaults": {
              "mappings": [
                {
                  "options": {
                    "1": {
                      "color": "green",
                      "index": 1,
                      "text": "UP"
                    },
                    "0": {
                      "color": "red",
                      "index": 0,
                      "text": "DOWN"
                    }
                  },
                  "type": "value"
                }
              ],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "red",
                    "value": null
                  },
                  {
                    "color": "green",
                    "value": 1
                  }
                ]
              }
            }
          }
        },
        {
          "id": 6,
          "title": "Memory Usage",
          "type": "stat",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 6,
            "y": 4
          },
          "targets": [
            {
              "expr": "fairdrive_process_resident_memory_bytes / 1024 / 1024",
              "refId": "A"
            }
          ],
          "options": {
            "graphMode": "area",
            "colorMode": "thresholds",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
              "values": false,
              "calcs": ["lastNotNull"],
              "fields": ""
            },
            "textMode": "auto",
            "unit": "mbytes"
          },
          "fieldConfig": {
            "defaults": {
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 1024
                  },
                  {
                    "color": "red",
                    "value": 2048
                  }
                ]
              }
            }
          }
        },
        {
          "id": 7,
          "title": "CPU Usage",
          "type": "stat",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 12,
            "y": 4
          },
          "targets": [
            {
              "expr": "rate(fairdrive_process_cpu_user_seconds_total[5m]) * 100",
              "refId": "A"
            }
          ],
          "options": {
            "graphMode": "area",
            "colorMode": "thresholds",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
              "values": false,
              "calcs": ["lastNotNull"],
              "fields": ""
            },
            "textMode": "auto",
            "unit": "percent"
          },
          "fieldConfig": {
            "defaults": {
              "max": 100,
              "min": 0,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 70
                  },
                  {
                    "color": "red",
                    "value": 90
                  }
                ]
              },
              "decimals": 1
            }
          }
        },
        {
          "id": 8,
          "title": "Online Pilots",
          "type": "stat",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 18,
            "y": 4
          },
          "targets": [
            {
              "expr": "sum(fairdrive_pilot_online_status)",
              "refId": "A"
            }
          ],
          "options": {
            "graphMode": "area",
            "colorMode": "value",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
              "values": false,
              "calcs": ["lastNotNull"],
              "fields": ""
            },
            "textMode": "auto"
          }
        },
        {
          "id": 9,
          "title": "Request Rate Over Time",
          "type": "graph",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 8
          },
          "targets": [
            {
              "expr": "sum(rate(fairdrive_http_requests_total[5m]))",
              "legendFormat": "Total Requests",
              "refId": "A"
            },
            {
              "expr": "sum(rate(fairdrive_http_errors_total[5m]))",
              "legendFormat": "Errors",
              "refId": "B"
            }
          ],
          "xaxis": {
            "mode": "time",
            "show": true
          },
          "yaxes": [
            {
              "format": "short",
              "show": true
            },
            {
              "format": "short",
              "show": true
            }
          ],
          "legend": {
            "show": true,
            "values": true,
            "current": true
          },
          "lines": true,
          "fill": 2,
          "tooltip": {
            "shared": true
          }
        },
        {
          "id": 10,
          "title": "Response Time Distribution",
          "type": "graph",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 8
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.50, rate(fairdrive_http_request_duration_seconds_bucket[5m]))",
              "legendFormat": "p50",
              "refId": "A"
            },
            {
              "expr": "histogram_quantile(0.95, rate(fairdrive_http_request_duration_seconds_bucket[5m]))",
              "legendFormat": "p95",
              "refId": "B"
            },
            {
              "expr": "histogram_quantile(0.99, rate(fairdrive_http_request_duration_seconds_bucket[5m]))",
              "legendFormat": "p99",
              "refId": "C"
            }
          ],
          "xaxis": {
            "mode": "time",
            "show": true
          },
          "yaxes": [
            {
              "format": "s",
              "show": true
            },
            {
              "format": "short",
              "show": true
            }
          ],
          "legend": {
            "show": true,
            "values": true,
            "current": true
          },
          "lines": true,
          "linewidth": 2,
          "tooltip": {
            "shared": true
          }
        }
      ],
      "annotations": {
        "list": []
      },
      "links": [
        {
          "title": "HTTP Metrics",
          "type": "dashboards",
          "tags": ["http"],
          "asDropdown": false,
          "icon": "dashboard"
        },
        {
          "title": "Business Metrics",
          "type": "dashboards",
          "tags": ["business"],
          "asDropdown": false,
          "icon": "dashboard"
        },
        {
          "title": "System Metrics",
          "type": "dashboards",
          "tags": ["system"],
          "asDropdown": false,
          "icon": "dashboard"
        },
        {
          "title": "Logs",
          "type": "dashboards",
          "tags": ["logs"],
          "asDropdown": false,
          "icon": "list-ul"
        }
      ]
    }
  }