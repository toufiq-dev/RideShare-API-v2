generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid())
  phone           String          @unique
  email           String?         @unique
  isEmailVerified Boolean?        @default(false)
  isPhoneVerified Boolean         @default(false)
  name            String?
  avatar          String?
  referralCode    String?
  role            UserRole
  status          UserStatus      @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastLogin       DateTime?
  metadata        Json?
  admin           Admin?
  customer        Customer?
  deviceTokens    DeviceToken[]
  pilot           Pilot?
  support         Support?
  supportTickets  SupportTicket[]
  transaction     Transaction[]
  session         UserSession[]

  @@index([phone])
}

model UserSession {
  id         String  @id @default(uuid())
  userId     String
  deviceInfo String?
  ipAddress  String?
  location   String?
  isActive   Boolean @default(true)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([location])
}

model DeviceToken {
  id         String     @id @default(uuid())
  userId     String
  token      String     @unique
  deviceType DeviceType
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Admin {
  id       String @id @default(uuid())
  name     String
  userId   String @unique
  email    String @unique
  password String
  user     User   @relation(fields: [userId], references: [id])
}

model Customer {
  id          String           @id @default(uuid())
  userId      String           @unique
  languageId  String
  bookings    Booking[]
  language    Languages        @relation(fields: [languageId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
  ratings     CustomerRating[]
  savedPlaces SavedPlace[]

  @@index([userId])
}

model SavedPlace {
  id         String   @id @default(uuid())
  customerId String
  name       String
  type       String
  address    String
  location   Json
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, type])
  @@index([customerId])
}

model Support {
  id           String @id @default(uuid())
  userId       String @unique
  email        String @unique
  password     String
  referralCode String
  user         User   @relation(fields: [userId], references: [id])
}

model Pilot {
  id                 String             @id @default(uuid())
  userId             String             @unique
  licenseNumber      String             @unique
  vehicleId          String
  isAvailable        Boolean            @default(false)
  currentLocation    Json?
  subscriptionId     String?
  totalTrips         Int                @default(0)
  averageRating      Float              @default(0)
  isDocumentVerified Boolean            @default(false)
  isAadharVerified   Boolean            @default(false)
  hasAcceptedTerms   Boolean            @default(false)
  languageId         String
  pilotProgram       PilotProgram       @default(REGULAR)
  bookings           Booking[]
  documents          Document[]
  language           Languages          @relation(fields: [languageId], references: [id])
  subscription       PilotSubscription? @relation(fields: [subscriptionId], references: [id])
  user               User               @relation(fields: [userId], references: [id])
  vehicle            Vehicle            @relation(fields: [vehicleId], references: [id])
  earnings           PilotEarning[]
  ranking            PilotRanking?
  ratings            PilotRating[]
  wallet             PilotWallet?
  videoProgress      VideoProgress?

  @@index([licenseNumber])
  @@index([vehicleId])
}

model PilotRanking {
  id      String @id @default(uuid())
  pilotId String @unique
  ranking Int    @default(0)
  pilot   Pilot  @relation(fields: [pilotId], references: [id])
}

model Languages {
  id           String        @id @default(uuid())
  name         String        @unique
  customers    Customer[]
  pilots       Pilot[]
  translations Translation[]
}

model Translation {
  id         String    @id @default(uuid())
  languageId String
  key        String
  content    String
  category   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  language   Languages @relation(fields: [languageId], references: [id])

  @@unique([languageId, key])
}

// rc number - > licensePlate
model Vehicle {
  id              String      @id @default(uuid())
  make            String
  model           String
  year            Int
  licensePlate    String      @unique
  color           String
  vehicleType     VehicleType
  capacity        Int
  insuranceExpiry DateTime
  puccExpiry      DateTime
  fitnessExpiry   DateTime
  documents       Document[]
  pilots          Pilot[]
}

model PilotWallet {
  id           String        @id @default(uuid())
  pilotId      String        @unique
  balance      Int
  minusLimit   Int           @default(-100)
  lastRecharge DateTime?
  pilot        Pilot         @relation(fields: [pilotId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  walletId    String?
  type        TransactionType
  amount      Decimal
  description String?
  bookingId   String?
  metadata    Json?
  createdAt   DateTime        @default(now())
  booking     Booking?        @relation(fields: [bookingId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
  pilotWallet PilotWallet?    @relation(fields: [walletId], references: [id])
}

model PilotSubscription {
  id           String                    @id @default(uuid())
  name         SubscriptionType
  price        Decimal
  coins        Int
  description  String
  features     Json
  isActive     Boolean                   @default(true)
  pilots       Pilot[]
  transactions SubscriptionTransaction[]
}

model PilotEarning {
  id          String   @id @default(uuid())
  pilotId     String
  amount      Decimal
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  pilot       Pilot    @relation(fields: [pilotId], references: [id])
}

model SubscriptionTransaction {
  id             String            @id @default(uuid())
  subscriptionId String
  amount         Decimal
  status         PaymentStatus
  paymentMethod  String
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime          @default(now())
  subscription   PilotSubscription @relation(fields: [subscriptionId], references: [id])
}

model Booking {
  id                 String          @id @default(uuid())
  bookingCode        String          @unique
  customerId         String
  pilotId            String?
  riderName          String?
  riderPhone         String?
  pickupLocation     Json
  dropLocation       Json
  actualDistance     Float?
  actualDuration     Int?
  tripStart          DateTime?
  tripEnd            DateTime?
  status             BookingStatus
  estimatedFare      Float?
  fare               Float?
  surgeMultiplier    Float?          @default(1.0)
  discount           Float?          @default(0.0)
  duration           Int?
  cancellationReason String?
  notes              String?
  scheduledFor       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  customer           Customer        @relation(fields: [customerId], references: [id])
  pilot              Pilot?          @relation(fields: [pilotId], references: [id])
  customerRating     CustomerRating?
  payment            Payment?
  pilotRating        PilotRating?
  supportTicket      SupportTicket?
  walletTransactions Transaction[]

  @@index([customerId])
  @@index([pilotId])
  @@index([status, createdAt])
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  amount        Decimal
  status        PaymentStatus
  paymentMethod String
  transactionId String?
  createdAt     DateTime      @default(now())
  metadata      Json?
  booking       Booking       @relation(fields: [bookingId], references: [id])

  @@index([status])
  @@index([createdAt])
}

model CustomerRating {
  id         String    @id @default(uuid())
  bookingId  String    @unique
  customerId String
  rating     Int       @db.SmallInt
  comment    String?
  createdAt  DateTime  @default(now())
  booking    Booking   @relation(fields: [bookingId], references: [id])
  customer   Customer  @relation(fields: [customerId], references: [id])
  feedback   Feedback?
}

model PilotRating {
  id        String     @id @default(uuid())
  bookingId String     @unique
  pilotId   String
  rating    Int        @db.SmallInt
  comment   String?
  createdAt DateTime   @default(now())
  feedback  Feedback[]
  booking   Booking    @relation(fields: [bookingId], references: [id])
  pilot     Pilot      @relation(fields: [pilotId], references: [id])
}

model Feedback {
  id               String         @id @default(uuid())
  ratingId         String?
  customerRatingId String         @unique
  pilotRatingId    String
  tags             String[]
  comment          String?
  createdAt        DateTime       @default(now())
  customerRating   CustomerRating @relation(fields: [customerRatingId], references: [id])
  pilotRating      PilotRating    @relation(fields: [pilotRatingId], references: [id])
}

model SupportTicket {
  id          String         @id @default(uuid())
  userId      String
  bookingId   String?        @unique
  type        SupportType
  channel     SupportChannel
  status      SupportStatus  @default(OPEN)
  description String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  booking     Booking?       @relation(fields: [bookingId], references: [id])
  user        User           @relation(fields: [userId], references: [id])
}

model Document {
  id           String       @id @default(uuid())
  pilotId      String
  vehicleId    String
  type         DocumentType
  documentUrl  String
  expiryDate   DateTime?
  alertMessage String
  isVerified   Boolean      @default(false)
  uploadedAt   DateTime     @default(now())
  pilot        Pilot        @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id])
}

model LegalDocument {
  id        String       @id @default(uuid())
  type      LegalDocType
  title     String
  content   String
  version   String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model VideoTutorial {
  id         String          @id @default(uuid())
  title      String
  videoUrl   String
  duration   Int
  order      Int
  isRequired Boolean         @default(false)
  progress   VideoProgress[]
}

model VideoProgress {
  id        String        @id @default(uuid())
  pilotId   String        @unique
  videoId   String
  completed Boolean       @default(false)
  pilot     Pilot         @relation(fields: [pilotId], references: [id])
  video     VideoTutorial @relation(fields: [videoId], references: [id])

  @@unique([pilotId, videoId])
}

enum DeviceType {
  IOS
  ANDROID
}

enum UserRole {
  ADMIN
  CUSTOMER
  PILOT
  SUPPORT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum PilotProgram {
  REGULAR
  STAR
  SUPER
}

enum VehicleType {
  HATCHBACK
  SEDAN
  SUV
  KALI_PEELI
  AUTO_RICKSHAW
}

enum DocumentType {
  DRIVING_LICENSE
  VEHICLE_REGISTRATION
  INSURANCE
  AADHAR_CARD
  PAN_CARD
  PROFILE_PHOTO
  PUCC
  FITNESS_CERTIFICATE
  OTHER
}

enum LegalDocType {
  PRIVACY_POLICY
  TERMS_CONDITIONS
  COPYRIGHT
  DATA_PROVIDERS
  SOFTWARE_LICENSE
  LOCATION_INFORMATION
  CITY_REGULATIONS
}

enum SubscriptionType {
  STARTER_PACK
  PRO_PACK
  MEGA_PACK
  FLEXI_PACK
}

enum BookingStatus {
  PENDING
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionType {
  SUBSCRIPTION_PURCHASE
  TRIP_DEDUCTION
  REFUND
  BONUS
  CUSTOMER_PAYMENT
  CUSTOMER_REFUND
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SupportType {
  GENERAL_INQUIRY
  BOOKING_ISSUE
  PAYMENT_ISSUE
  TECHNICAL_SUPPORT
  COMPLAINT
  OTHER
}

enum SupportChannel {
  EMAIL
  CHAT
  PHONE
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
