FROM node:24-alpine

RUN npm i -g pnpm

WORKDIR /app

COPY package*.json ./
COPY pnpm-lock.yaml ./
RUN pnpm install

COPY prisma ./prisma
RUN pnpm prisma generate

# Copy config files
COPY tsconfig.json ./
COPY nest-cli.json ./

# Build the application for development
RUN pnpm run build:dev

# Expose the port
EXPOSE 3000

CMD ["pnpm", "run", "start:dev"]