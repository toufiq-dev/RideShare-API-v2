generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  role           UserRole
  status         UserStatus      @default(ACTIVE)
  metadata       Json?
  lastLogin      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  admin          Admin?
  customer       Customer?
  deviceTokens   DeviceToken[]
  pilot          Pilot?
  support        Support?
  supportTickets SupportTicket[]
  transaction    Transaction[]
  session        UserSession[]
}

model UserSession {
  id         String  @id @default(uuid())
  userId     String
  deviceInfo String?
  ipAddress  String?
  isActive   Boolean @default(true)
  location   Json?
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([location])
}

model DeviceToken {
  id              String   @id @default(uuid())
  userId          String
  token           String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  appVersion      String
  dateTime        String
  platform        String
  platformVersion String
  user            User     @relation(fields: [userId], references: [id])
}

model Admin {
  id       String @id @default(uuid())
  name     String
  userId   String @unique
  email    String @unique
  password String
  user     User   @relation(fields: [userId], references: [id])
}

model Support {
  id           String   @id @default(uuid())
  userId       String   @unique
  name         String
  referralCode String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model Customer {
  id                  String           @id @default(uuid())
  phone               String           @unique
  email               String?          @unique
  userId              String           @unique
  isAlreadyRegistered Boolean          @default(false)
  isEmailVerified     Boolean          @default(false)
  name                String?
  avatar              String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  languageId          String
  bookings            Booking[]
  language            Languages        @relation(fields: [languageId], references: [id])
  user                User             @relation(fields: [userId], references: [id])
  ratings             CustomerRating[]
  savedPlaces         SavedPlace[]
}

model SavedPlace {
  id         String         @id @default(uuid())
  customerId String
  name       String?
  address    String
  type       SavedPlaceType @default(OTHERS)
  location   Json?
  customer   Customer       @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model Pilot {
  id                  String             @id @default(uuid())
  phone               String             @unique
  userId              String             @unique
  referralCode        String
  isAlreadyRegistered Boolean            @default(false)
  isAvailable         PilotStatus        @default(OFFLINE)
  totalTrips          Int                @default(0)
  averageRating       Float              @default(0)
  languageId          String
  pilotProgramId      String?
  selfieUrl           String?
  acceptedTerms       Boolean            @default(true)
  isDLVerified        Boolean            @default(false)
  isRCVerified        Boolean            @default(false)
  isPanCardVerified   Boolean            @default(false)
  isAadhaarVerified   Boolean            @default(false)
  isFairCoinAvailed   Boolean            @default(false)
  currentLocation     Json?
  panCardName         String?
  aadhaarName         String?
  panCardNumber       String?            @unique
  aadhaarCardNumber   String?            @unique
  aadhaarCardAddress  String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  activeBookingId     String?            @unique
  bookings            Booking[]
  drivingLicense      DrivingLicense?
  language            Languages          @relation(fields: [languageId], references: [id])
  pilotProgram        PilotProgram?      @relation(fields: [pilotProgramId], references: [id])
  user                User               @relation(fields: [userId], references: [id])
  activeBooking       Booking?           @relation("ActiveBooking", fields: [activeBookingId], references: [id])
  earnings            PilotTripEarning[]
  ranking             PilotRanking?
  ratings             PilotRating[]
  wallet              PilotWallet?
  vehicles            Vehicle[]
  videoProgress       VideoProgress?

  @@index([isAvailable])
  @@index([currentLocation])
}

model DrivingLicense {
  id               String   @id @default(uuid())
  pilotId          String   @unique
  licenseNumber    String   @unique
  nameOnLicense    String
  dateOfBirth      DateTime
  dateOfIssue      DateTime
  validUntill      DateTime
  permanentAddress String?
  temporaryAddress String?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  pilot            Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@index([licenseNumber])
}

model Vehicle {
  id            String      @id @default(uuid())
  pilotId       String
  regNo         String      @unique
  fitUpto       DateTime
  insuranceUpto DateTime
  puccUpto      DateTime
  regUpto       DateTime
  permitUpto    DateTime
  manufacturer  String
  status        String
  colour        String
  model         String
  state         String
  seatCapacity  String
  vehicleTypeId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  pilot         Pilot       @relation(fields: [pilotId], references: [id])
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])
}

model VehicleType {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  vehicle     Vehicle[]
}

model PilotProgram {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  pilot       Pilot[]
}

model PilotRanking {
  id      String @id @default(uuid())
  pilotId String @unique
  ranking Int    @default(0)
  pilot   Pilot  @relation(fields: [pilotId], references: [id])
}

model Languages {
  id           String        @id @default(uuid())
  name         String        @unique
  customers    Customer[]
  pilots       Pilot[]
  translations Translation[]
}

model Translation {
  id         String    @id @default(uuid())
  languageId String
  key        String
  content    String
  category   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  language   Languages @relation(fields: [languageId], references: [id])

  @@unique([languageId, key])
}

model Subscription {
  id                  String        @id @default(uuid())
  name                String        @unique
  coins               Decimal       @db.Decimal(10, 2)
  price               Decimal       @db.Decimal(10, 2)
  priceBeforeDiscount Decimal?      @db.Decimal(10, 2)
  tag                 String?
  transactions        Transaction[]
  wallets             PilotWallet[]
}

model PilotTripEarning {
  id        String   @id @default(uuid())
  pilotId   String
  amount    Decimal  @db.Decimal(10, 2)
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pilot     Pilot    @relation(fields: [pilotId], references: [id])
}

model PilotWallet {
  id              String        @id @default(uuid())
  pilotId         String        @unique
  balance         Decimal       @db.Decimal(10, 2)
  minusLimit      Decimal       @default(-100.00) @db.Decimal(10, 2)
  todaysEarning   Decimal?      @db.Decimal(10, 2)
  lastTripEarning Decimal?      @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())
  subscriptionId  String
  pilot           Pilot         @relation(fields: [pilotId], references: [id])
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id])
  transactions    Transaction[]
}

model Transaction {
  id             String          @id @default(uuid())
  userId         String
  walletId       String?
  type           TransactionType
  order_id       String?
  amount         Decimal         @db.Decimal(10, 2)
  balanceBefore  Decimal?        @db.Decimal(10, 2)
  balanceAfter   Decimal?        @db.Decimal(10, 2)
  metadata       Json?
  createdAt      DateTime        @default(now())
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  pilotWallet    PilotWallet?    @relation(fields: [walletId], references: [id])
}

model Booking {
  id                   String              @id @default(uuid())
  bookingCode          String              @unique
  customerId           String
  pilotId              String?
  status               BookingStatus
  estimatedFare        Decimal?            @db.Decimal(10, 2)
  fare                 Decimal?            @db.Decimal(10, 2)
  pickupLocation       Json
  dropLocation         Json
  actualDistance       Float?
  duration             Int?
  actualDuration       Int?
  tripStart            DateTime?
  tripEnd              DateTime?
  surgeMultiplier      Decimal?            @default(1.0) @db.Decimal(10, 2)
  discount             Decimal?            @default(0.0) @db.Decimal(10, 2)
  notes                String?
  acceptedAt           DateTime?
  arrivedAt            DateTime?
  scheduledFor         DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  cancellationReasonId String?
  cancellationReason   CancellationReason? @relation(fields: [cancellationReasonId], references: [id])
  customer             Customer            @relation(fields: [customerId], references: [id])
  pilot                Pilot?              @relation(fields: [pilotId], references: [id])
  activePilot          Pilot?              @relation("ActiveBooking")
  customerRating       CustomerRating?
  pilotRating          PilotRating?
  supportTicket        SupportTicket?

  @@index([customerId])
  @@index([pilotId])
  @@index([status, createdAt])
}

model CancellationReason {
  id        String    @id @default(uuid())
  reason    String
  bookingId String
  booking   Booking[]
}

model CustomerRating {
  id         String    @id @default(uuid())
  bookingId  String    @unique
  customerId String
  rating     Int       @db.SmallInt
  comment    String?
  createdAt  DateTime  @default(now())
  booking    Booking   @relation(fields: [bookingId], references: [id])
  customer   Customer  @relation(fields: [customerId], references: [id])
  feedback   Feedback?
}

model PilotRating {
  id        String     @id @default(uuid())
  bookingId String     @unique
  pilotId   String
  rating    Int        @db.SmallInt
  comment   String?
  createdAt DateTime   @default(now())
  feedback  Feedback[]
  booking   Booking    @relation(fields: [bookingId], references: [id])
  pilot     Pilot      @relation(fields: [pilotId], references: [id])
}

model Feedback {
  id               String         @id @default(uuid())
  ratingId         String?
  customerRatingId String         @unique
  pilotRatingId    String
  tags             String[]
  comment          String?
  createdAt        DateTime       @default(now())
  customerRating   CustomerRating @relation(fields: [customerRatingId], references: [id])
  pilotRating      PilotRating    @relation(fields: [pilotRatingId], references: [id])
}

model SupportTicket {
  id          String         @id @default(uuid())
  userId      String
  bookingId   String?        @unique
  type        SupportType
  channel     SupportChannel
  status      SupportStatus  @default(OPEN)
  description String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  booking     Booking?       @relation(fields: [bookingId], references: [id])
  user        User           @relation(fields: [userId], references: [id])
}

model Policy {
  id        String   @id @default(uuid())
  type      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoTutorial {
  id         String          @id @default(uuid())
  title      String
  videoUrl   String
  duration   Int
  order      Int
  isRequired Boolean         @default(false)
  progress   VideoProgress[]
}

model VideoProgress {
  id        String        @id @default(uuid())
  pilotId   String        @unique
  videoId   String
  completed Boolean       @default(false)
  pilot     Pilot         @relation(fields: [pilotId], references: [id])
  video     VideoTutorial @relation(fields: [videoId], references: [id])

  @@unique([pilotId, videoId])
}

enum UserRole {
  ADMIN
  CUSTOMER
  PILOT
  SUPPORT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum PilotStatus {
  AVAILABLE
  ON_TRIP
  OFFLINE
}

enum BookingStatus {
  PENDING
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionType {
  SUBSCRIPTION_PURCHASE
  TRIP_DEDUCTION
  ONBOARDING_OFFER
}

enum SupportType {
  GENERAL_INQUIRY
  BOOKING_ISSUE
  PAYMENT_ISSUE
  TECHNICAL_SUPPORT
  COMPLAINT
  OTHER
}

enum SupportChannel {
  EMAIL
  CHAT
  PHONE
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SavedPlaceType {
  HOME
  WORK
  RESTAURANT
  GYM
  COLLEGE
  OTHERS
}
